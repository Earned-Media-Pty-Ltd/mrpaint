.type h4{ font-size: 20px }
.type p{ color: var(--ink-2); font-size: 14.5px }
@media (max-width: 1000px){ .types-grid{ grid-template-columns: 1fr 1fr } }
@media (max-width: 540px){ .types-grid{ grid-template-columns: 1fr } }

.includes-grid{ display:grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px,4vw,72px); align-items:center }
.includes-list{ list-style:none; padding:0; margin:18px 0 0; display:grid; grid-template-columns:1fr 1fr; gap: 12px 24px }
.includes-list li{ display:flex; gap:10px; align-items:flex-start; font-size:15.5px; color: var(--ink-2) }
