}
.includes-img{ aspect-ratio: 1/1; border-radius: var(--radius-l); overflow:hidden; border:1px solid var(--rule) }
.includes-img img{ width:100%; height:100%; object-fit:cover }
@media (max-width: 860px){ .includes-grid{ grid-template-columns: 1fr } .includes-list{ grid-template-columns: 1fr } }
