---
layout: base.njk
title: Industrial Painting Cairns — Tailored Solutions
description: Industrial painting in Cairns. Two-pack systems, epoxy floors, factory roofs, warehouses, plant rooms and line-marking. Get a free quote.
permalink: /industrial-painting/
canonical: /industrial-painting/
---
{% from "page-hero.njk" import pageHero %}
<style>
.page-hero{ padding: clamp(48px,7vw,90px) 0 clamp(28px,4vw,56px); position:relative; overflow:hidden }
.page-hero::before{ content:""; position:absolute; right:-160px; top:-100px; width:480px; height:480px; border-radius:50%; background:var(--yellow); opacity:.5; z-index:0 }
.page-hero .wrap{ position:relative; z-index:1 }
.page-hero h1{ font-size: clamp(48px, 6vw, 100px); }
.page-hero h1 .high{ background:var(--yellow); padding:0 .1em .04em; border-radius:8px; display:inline-block; box-decoration-break:clone; -webkit-box-decoration-break:clone }

.specs{ background:var(--bg-soft) }
.specs-grid{ display:grid; grid-template-columns: repeat(4,1fr); gap: 14px }
.spec{
  background:#fff; border:1px solid var(--rule); border-radius:var(--radius);
  padding: 22px; display:flex; flex-direction:column; gap: 12px; min-height: 200px;
  position:relative;
}
.spec .num{ font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--muted) }
.spec h4{ font-size:18px; margin-top:4px }
.spec p{ color:var(--ink-2); font-size:14px }
.spec .tick{ font-family:var(--mono); font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--ink); display:inline-flex; padding:4px 10px; background:var(--yellow); border-radius:999px; margin-top:auto; align-self:flex-start }
@media (max-width: 1000px){ .specs-grid{ grid-template-columns: 1fr 1fr } }
@media (max-width: 540px){ .specs-grid{ grid-template-columns: 1fr } }

.surface-grid{ display:grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px,4vw,72px); align-items:center }
.surface-img{ aspect-ratio: 1/1; border-radius: var(--radius-l); overflow:hidden; border:1px solid var(--rule) }
.surface-img img{ width:100%; height:100%; object-fit:cover }
.brand-list{ display:grid; grid-template-columns:1fr 1fr; gap:12px 24px; list-style:none; padding:0; margin:18px 0 0 }
.brand-list li{ display:flex; gap:10px; align-items:flex-start; font-size:15.5px; color:var(--ink-2) }
.brand-list li::before{
  content:""; width:18px; height:18px; flex:0 0 auto; margin-top:3px;
  background: var(--ink);
  -webkit-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M5 12l4 4L19 6' stroke='black' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>") center/contain no-repeat;
          mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M5 12l4 4L19 6' stroke='black' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>") center/contain no-repeat;
}
@media (max-width: 860px){ .surface-grid{ grid-template-columns: 1fr } .brand-list{ grid-template-columns: 1fr } }

.line-marking{ background:var(--ink); color:#fff; padding: var(--gap) 0 }
.line-marking h2{ color:#fff }
.lm-grid{ display:grid; grid-template-columns: 1fr 1fr; gap: clamp(28px,4vw,72px); align-items:center }
.lm-img{ aspect-ratio: 4/3; border-radius: var(--radius-l); overflow:hidden; background: var(--bg-soft) }
.lm-img img{ width:100%; height:100%; object-fit:cover }
.lm-tags{ display:flex; flex-wrap:wrap; gap: 8px; margin-top: 20px }
.lm-tag{ font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; padding:6px 12px; border-radius:999px; background:rgba(255,255,255,.08); color:rgba(255,255,255,.8); border:1px solid rgba(255,255,255,.18) }
@media (max-width: 860px){ .lm-grid{ grid-template-columns: 1fr } }
</style>{% set svc = services | findBy("slug","industrial-painting") %}

{% call pageHero(svc.hero_eyebrow, svc.h1, svc.intro) %}
      <a class="btn btn--yellow btn--lg" href="/contact-us/">Quote an industrial job <span class="arr">→</span></a>
      <a class="btn btn--ghost btn--lg" href="#systems">See coating systems</a>{% endcall %}

<div class="trust" aria-hidden="true">
  <div class="track">
    <span>Family-run business</span><span class="dot"></span>
    <span>Trade-qualified painters</span><span class="dot"></span>
    <span>Fully licensed &amp; insured</span><span class="dot"></span>
    <span>Free on-site quotes</span><span class="dot"></span>
    <span>Two-pack &amp; epoxy systems</span><span class="dot"></span>
    <span>Working at heights certified</span><span class="dot"></span>
    <span>Family-run business</span><span class="dot"></span>
    <span>Trade-qualified painters</span><span class="dot"></span>
    <span>Fully licensed &amp; insured</span><span class="dot"></span>
    <span>Free on-site quotes</span><span class="dot"></span>
    <span>Two-pack &amp; epoxy systems</span><span class="dot"></span>
    <span>Working at heights certified</span><span class="dot"></span>
  </div>
</div>

<section class="specs">
  <div class="wrap">
    <div class="sec-head split">
      <div>
        <span class="eyebrow">Industrial scope</span>
        <h2>Built for the kind of jobs<br/>most painters say no to.</h2>
      </div>
      <div class="right">
        {% if svc.blocks.specs_lede %}<p class="lede">{{ svc.blocks.specs_lede }}</p>{% endif %}
      </div>
    </div>
    {% if svc.specs | length %}<div class="specs-grid">{% for s in (svc.specs if svc else []) %}
      <div class="spec">
        <span class="num">{{ s.num }}</span>
        <h4>{{ s.title }}</h4>
        <p>{{ s.body }}</p>
        <span class="tick">{{ s.tick }}</span>
      </div>{% endfor %}
    </div>{% endif %}
  </div>
</section>

<section id="systems" style="background:#fff">
  <div class="wrap">
    <div class="surface-grid">
      <div>
        <span class="eyebrow">Coating systems</span>
        <h2 style="margin-top:14px">Specced for the substrate,<br/>not the salesperson.</h2>
        {% if svc.blocks.specs_close %}<p class="lede" style="margin-top:22px">
          {{ svc.blocks.specs_close }}
        </p>{% endif %}
        <ul class="brand-list">
          <li>Protective coatings</li>
          <li>Epoxy finishes &amp; 2-pacs</li>
          <li>Solvent-based systems</li>
          <li>Industrial floor coatings</li>
        </ul>
        <div style="margin-top:28px"><a class="btn" href="/contact-us/">Talk specs <span class="arr">→</span></a></div>
      </div>
      <div class="surface-img">
        <img src="/assets/images/work-roof-safety-access.jpg" alt="Industrial roof painting" />
      </div>
    </div>
  </div>
</section>

<section class="line-marking">
  <div class="wrap">
    <div class="lm-grid">
      <div>
        <span class="eyebrow" style="color:rgba(255,255,255,.7)">Line marking</span>
        <h2 style="margin-top:14px">Bays, aisles &amp; safety lines<br/>that don't peel by Easter.</h2>
        {% if svc.blocks.line_marking_lede %}<p class="lede" style="margin-top:22px;color:rgba(255,255,255,.82)">
          {{ svc.blocks.line_marking_lede }}
        </p>{% endif %}
        <div class="lm-tags">
          <span class="lm-tag">Carparks</span>
          <span class="lm-tag">Warehouses</span>
          <span class="lm-tag">Safety zones</span>
          <span class="lm-tag">Loading docks</span>
          <span class="lm-tag">Safety colours</span>
        </div>
        <div style="margin-top:28px"><a class="btn btn--yellow" href="/contact-us/">Quote line marking <span class="arr">→</span></a></div>
      </div>
      <div class="lm-img">
        <img src="/assets/images/work-commercial-fitout.jpg" alt="Industrial floor with line marking" />
      </div>
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap">
    <div class="grid">
      <div>
        <span class="eyebrow">Get an industrial quote</span>
        <h2>Site walk-through.<br/>Spec in writing. Then start.</h2>
        {% if svc.blocks.cta_lede %}<p class="lede">{{ svc.blocks.cta_lede }}</p>{% endif %}
        <div class="contact-list">
          <div class="row"><span class="lbl">Phone</span><a href="{{ site.phone_link }}">{{ site.phone_display }}</a></div>
          <div class="row"><span class="lbl">Email</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
        </div>
      </div>
      <form class="qform" style="background:#fff;border-color:rgba(22,20,19,.18)" action="/api/contact/" method="POST">
        <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
        <div style="font-family:var(--display);font-size: clamp(22px,2.2vw,28px);font-weight:600;letter-spacing:-.02em">Industrial enquiry</div>
        <div><label>Company / site</label><input class="field" name="company" placeholder="Company name" /></div>
        <div><label>Sector</label>
          <select class="field" name="sector"><option>Warehouse / workshop</option><option>Factory roof</option><option>Plant room / tank</option><option>Carpark / line marking</option><option>Other</option></select>
        </div>
        <div><label>Approx. area</label><input class="field" name="area" placeholder="800 m² roof / 200 bays / etc." /></div>
        <div><label>Best contact</label><input class="field" name="phone" placeholder="04…" /></div>
        <div style="display:flex;justify-content:flex-end;margin-top:6px"><button class="btn" type="submit">Send <span class="arr">→</span></button></div>
      </form>
    </div>
  </div>
</section>
