{% from "cta-section.njk" import ctaSection with context %}{% from "page-hero.njk" import pageHero %}{% from "faq-section.njk" import faqSection %}
<style>
.page-hero{ padding: clamp(48px,7vw,90px) 0 clamp(28px,4vw,56px); position:relative; overflow:hidden }
.page-hero::before{ content:""; position:absolute; right:-160px; top:-100px; width:480px; height:480px; border-radius:50%; background:var(--yellow); opacity:.5; z-index:0 }
.page-hero .wrap{ position:relative; z-index:1 }
.page-hero h1{ font-size: clamp(48px, 6vw, 100px); }
.page-hero h1 .high{ background:var(--yellow); padding:0 .1em .04em; border-radius:8px; display:inline-block; box-decoration-break:clone; -webkit-box-decoration-break:clone }

.rooftype-grid{ display:grid; grid-template-columns: 1.1fr 1fr; gap: clamp(28px,4vw,72px); align-items:center }
.rooftype-grid.rev{ grid-template-columns: 1fr 1.1fr }
.rooftype-img{ aspect-ratio: 4/3; border-radius: var(--radius-l); overflow:hidden; border:1px solid var(--rule) }
.rooftype-img img{ width:100%; height:100%; object-fit:cover }
@media (max-width: 860px){ .rooftype-grid, .rooftype-grid.rev{ grid-template-columns: 1fr } }

.faq-list details{ background:#fff; border:1px solid var(--rule); border-radius:var(--radius); padding: 18px 22px; margin-bottom: 10px }
.faq-list summary{ cursor:pointer; font-weight:600; font-size:16px; display:flex; justify-content:space-between; gap:14px; list-style:none }
.faq-list summary::-webkit-details-marker{ display:none }
.faq-list .plus{ color:var(--yellow); font-weight:700 }
.faq-list details div{ margin-top: 12px; color:var(--ink-2); font-size:15px; line-height:1.6 }
